                  "disabled": false,
                  "key": "start_day",
                  "value": "<date>",
                  "description": "start date"
                },
                {
                  "disabled": false,
                  "key": "end_day",
                  "value": "<date>",
                  "description": "end date"
                },
                {
                  "disabled": false,
                  "key": "resolution",
                  "value": "<string>",
                  "description": "Resolve daily."
                },
                {
                  "disabled": false,
