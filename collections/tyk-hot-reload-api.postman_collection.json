        {
          "id": "a7f88bd6-da0d-4de9-8f36-0baecf690bf8",
          "name": "Hot-reload a Group of Tyk Nodes.",
          "request": {
            "name": "Hot-reload a Group of Tyk Nodes.",
            "description": {
              "content": "To reload a whole group of Tyk nodes (without using the Dashboard or host manager). You can send an API request to a single node, this node will then send a notification through the pub/sub infrastructure to all other listening nodes (including the host manager if it is being used to manage Nginx) which will then trigger a global reload.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "tyk",
                "reload",
                "group"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
