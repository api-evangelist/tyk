      "id": "36b4b461-5d12-4a7b-a2c4-aae077b47c48",
      "name": "Hot Reload",
      "description": {
        "content": "Force restart of the Gateway or whole cluster.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "d1d1563d-7ab8-40bb-9b34-40f735c5a803",
          "name": "Tyk Hot-reload a Single Node.",
          "request": {
            "name": "Tyk Hot-reload a Single Node.",
            "description": {
              "content": "Tyk is capable of reloading configurations without having to stop serving requests. This means that API configurations can be added at runtime, or even modified at runtime and those rules applied immediately without any downtime.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "tyk",
                "reload"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "block",
                  "value": "<boolean>",
                  "description": "Block a response until the reload is performed. This can be useful in scripting environments like CI/CD workflows."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
