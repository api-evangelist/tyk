          "name": "Tyk Retrieve Environment Variables",
          "request": {
            "name": "Tyk Retrieve Environment Variables",
            "description": {
              "content": "Returns the current configuration status of the system.\n\n**Example curl command:**\n\n```bash\ncurl -X GET \\ \nhttp://localhost:8181/config\n-H 'X-Tyk-Authorization: your-secret-key'\n```\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "env"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Secret value set in sink.conf",
                "key": "X-Tyk-Authorization",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "ed3b4c51-9eaf-404e-a553-103a9561ec47",
              "name": "Successful retrieval of environment variables.",
              "originalRequest": {
                "url": {
                  "path": [
