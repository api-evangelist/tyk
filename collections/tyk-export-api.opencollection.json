{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tyk Dashboard Admin Additional Permissions Export API",
    "version": "5.3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Admin-Auth",
      "value": "{{Admin-Auth}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Export",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Export Organisations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost/admin/organisations/:orgID",
            "params": [
              {
                "name": "orgID",
                "value": "",
                "type": "path",
                "description": "ID of organisation"
              }
            ]
          },
          "docs": "The organisation object is the most fundamental object in a Tyk setup, all other ownership properties hang off the relationship between an organisation and its APIs, Policies and API Tokens."
        }
      ]
    }
  ],
  "bundled": true
}