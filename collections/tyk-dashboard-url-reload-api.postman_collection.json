            "description": {
              "content": "Reloads dashboard urls.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "admin",
                "system",
                "reload"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
