          "name": "Update OPA rules.",
          "request": {
            "name": "Update OPA rules.",
            "description": {
              "content": "Modify your OPA rules.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "org",
                "opa"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"open_policy\": {\n    \"rules\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "fbaa6ae1-7ca9-474e-ab7c-c1a55a231559",
              "name": "OPA rules updated.",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "org",
                    "opa"
