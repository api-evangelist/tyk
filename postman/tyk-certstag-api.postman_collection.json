  "info": {
    "_postman_id": "25bdc7a4-3ae0-416b-b112-8eb55bf22556",
    "name": "Tyk Dashboard Admin Additional Permissions CertsTag API",
    "description": "For Tyk On-Premises installations only, the Dashboard Admin API has two endpoints and is used to set up and provision a Tyk Dashboard instance without the command line.\n\nIn order to use the Dashboard Admin API, you'll need to get the `admin_secret` value from your Tyk Dashboard configurations.\n\nThe secret you set should then be sent along as a header with each Dashboard Admin API Request in order for it to be successful:\n\n```\nadmin-auth: <your-secret>\n```",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T03:21:38.000Z",
    "updatedAt": "2026-07-28T03:21:38.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-25bdc7a4-3ae0-416b-b112-8eb55bf22556"
  },
