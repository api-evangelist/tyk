      "item": [
        {
          "name": "Tyk Retrieve Environment Variables",
          "id": "e1388157-979d-4149-a635-edd86fbddb06",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "description": "(Required) Secret value set in sink.conf",
                "key": "X-Tyk-Authorization",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/env",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "env"
              ]
            },
            "description": "Returns the current configuration status of the system.\n\n**Example curl command:**\n\n```bash\ncurl -X GET \\ \nhttp://localhost:8181/config\n-H 'X-Tyk-Authorization: your-secret-key'\n```\n"
          },
